# Waitlist mode: false = every CTA goes to /waitlist and /start, /checkout, /gift redirect there.
NEXT_PUBLIC_CHECKOUT_ENABLED=false

# Supabase — optional for now (run supabase/migrations/*_waitlist_signups.sql first).
# Without these, signups go to the Formspree form (current setup).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend confirmation email. Without a key, no email is sent.
RESEND_API_KEY=
WAITLIST_FROM_EMAIL="Jolin at Legacy Link <info@legacylinkstudio.com>"
WAITLIST_REPLY_TO=info@legacylinkstudio.com

# Basic-auth password for /admin/waitlist (any username). Unset = admin locked.
ADMIN_PASSWORD=
